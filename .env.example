# .env.example - 复制为 .env 并修改
# 支持 Windows 10 和 Linux 跨平台

# ===== 防止重复加载 =====
if [ -n "$ENV_LOADED" ]; then
    return 0 2>/dev/null || exit 0
fi
export ENV_LOADED=true

# ===== UV 配置 =====
export UV_LINK_MODE="copy"

# 使用国内镜像源加速（根据你的网络选择）
# 清华源（推荐）
# export UV_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple"
# 或阿里源
# export UV_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"
# 或腾讯源
export UV_INDEX_URL="https://mirrors.cloud.tencent.com/pypi/simple/"

# 增加并发下载数（加速）
export UV_CONCURRENT_DOWNLOADS=50

# 设置缓存目录（可选）
export UV_CACHE_DIR="${HOME}/.cache/uv"

# ===== 项目配置 =====
# 自动检测项目根目录
if [ -z "$PROJECT_ROOT" ]; then
    # 如果 PROJECT_ROOT 未设置，尝试自动检测
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    export PROJECT_ROOT="$SCRIPT_DIR"
fi

# ===== 操作系统检测和路径配置 =====
case "$OSTYPE" in
  msys* | cygwin* | win32* | mingw*)
    # ===== Windows 10 环境 =====
    export IS_WINDOWS=true

    # Windows 下使用反斜杠或正斜杠（Git Bash 支持正斜杠）
    export PROJECT_ROOT="${PROJECT_ROOT:-$(pwd)}"  # Git Bash 路径格式

    # Windows 模型目录（可根据需要修改）
    export LLAMA_MODEL_DIR="${HOME}/models"

    # Windows UV 缓存目录
    export UV_CACHE_DIR="${USERPROFILE}/.cache/uv"

    # Windows 下的 llama-server 路径（可选）
    # 如果 llama-server 在 PATH 中，可以注释掉
    if command -v llama-server.exe &> /dev/null; then
        export LLAMA_SERVER="llama-server.exe"
    else
        # 常见安装路径
        if [ -f "H:/dev/llama.cpp/build/bin/Release/llama-server.exe" ]; then
            export LLAMA_SERVER="H:/dev/llama.cpp/build/bin/Release/llama-server.exe"
        elif [ -f "C:/llama.cpp/build/bin/Release/llama-server.exe" ]; then
            export LLAMA_SERVER="C:/llama.cpp/build/bin/Release/llama-server.exe"
        fi
    fi

    # Windows Python 路径（如果需要）
    # export PYTHON_PATH="/c/Python312/python.exe"

    echo "🪟 检测到 Windows 10 环境"
    ;;

  linux* | darwin*)
    # ===== Linux/Debian/Ubuntu 环境 =====
    export IS_WINDOWS=false

    # Linux 项目根目录
    export PROJECT_ROOT="${PROJECT_ROOT:-/workspace}"

    # Linux 模型目录（需要确保目录存在且有权限）
    export LLAMA_MODEL_DIR="/opt/models"

    # 如果模型目录不存在或不可写，使用用户目录
    if [ ! -d "$LLAMA_MODEL_DIR" ] || [ ! -w "$LLAMA_MODEL_DIR" ]; then
        export LLAMA_MODEL_DIR="${HOME}/models"
        mkdir -p "$LLAMA_MODEL_DIR"
    fi

    # Linux UV 缓存目录
    export UV_CACHE_DIR="${HOME}/.cache/uv"

    # Linux 下的 llama-server 路径
    if command -v llama-server &> /dev/null; then
        export LLAMA_SERVER="llama-server"
    elif [ -f "/usr/local/bin/llama-server" ]; then
        export LLAMA_SERVER="/usr/local/bin/llama-server"
    elif [ -f "./llama-server" ]; then
        export LLAMA_SERVER="./llama-server"
    fi

    echo "🐧 检测到 Linux 环境"
    ;;

  *)
    echo "⚠️ 未知操作系统: $OSTYPE"
    export IS_WINDOWS=false
    export LLAMA_MODEL_DIR="${HOME}/models"
    ;;
esac

# ===== 创建必要的目录 =====
mkdir -p "$UV_CACHE_DIR" 2>/dev/null || true
mkdir -p "$LLAMA_MODEL_DIR" 2>/dev/null || true

# ===== 模型文件配置 =====
# 默认模型（用于一般使用）
export LLAMA_MODEL="${LLAMA_MODEL_DIR}/tinyllama.gguf"

# 测试模型（用于 pytest，优先级高于 LLAMA_MODEL）
# Embedding 模型（用于向量嵌入测试）
export TEST_EMBEDDING_MODEL="${LLAMA_MODEL_DIR}/embeddinggemma-300m-Q4_0.gguf"

# Chat Completion 模型（用于对话补全测试）
export TEST_CHAT_MODEL="${LLAMA_MODEL_DIR}/qwen3-4b-instruct-2507-iq4_nl.gguf"

# 备用模型（当主模型不可用时使用）
export TEST_FALLBACK_MODEL="${LLAMA_MODEL_DIR}/tinyllama.gguf"

# 服务配置
export LLAMA_HOST="0.0.0.0"
export LLAMA_PORT="8080"

# GPU 层数
# Windows: 如果使用 CUDA，可以设为 99
# Linux: 根据 GPU 情况调整，0 为纯 CPU
if [ "$IS_WINDOWS" = true ]; then
    export LLAMA_N_GPU_LAYERS="99"  # Windows 通常有 GPU
else
    # Linux 自动检测 GPU
    if command -v nvidia-smi &> /dev/null; then
        export LLAMA_N_GPU_LAYERS="99"  # NVIDIA GPU 可用
        echo "🎮 检测到 NVIDIA GPU"
    else
        export LLAMA_N_GPU_LAYERS="0"   # 纯 CPU 模式
        echo "💻 使用 CPU 模式"
    fi
fi

# 上下文大小（根据模型调整）
export LLAMA_CONTEXT_SIZE="2048"

# ===== 虚拟环境配置 =====
export VENV_PATH="${PROJECT_ROOT}/.venv"

# 自动激活虚拟环境（只在未激活时）
if [ -z "$VIRTUAL_ENV" ]; then
    if [ -f "$VENV_PATH/bin/activate" ]; then
        # Windows 和 Linux 统一使用 bin/activate（Git Bash 兼容）
        source "$VENV_PATH/bin/activate" 2>/dev/null || \
        source "$VENV_PATH/Scripts/activate" 2>/dev/null  # Windows 原生 Python

        if [ -n "$VIRTUAL_ENV" ]; then
            echo "✅ 虚拟环境已激活: $(basename $VIRTUAL_ENV)"
        fi
    elif [ -f "$VENV_PATH/Scripts/activate" ]; then
        # Windows 原生 Python 虚拟环境
        source "$VENV_PATH/Scripts/activate"
        echo "✅ Windows 虚拟环境已激活"
    else
        echo "⚠️ 虚拟环境不存在，请运行: uv venv && source .venv/bin/activate"
    fi
fi

# ===== 显示配置摘要 =====
if [ -z "$ENV_SUMMARY_SHOWN" ]; then
    export ENV_SUMMARY_SHOWN=true
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📋 环境配置摘要"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "OS:        $([ "$IS_WINDOWS" = true ] && echo "Windows" || echo "Linux")"
    echo "Project:   $PROJECT_ROOT"
    echo "Models:    $LLAMA_MODEL_DIR"
    echo "GPU层数:   $LLAMA_N_GPU_LAYERS"
    echo "Python:    $(which python 2>/dev/null || echo "Not found")"
    echo "UV:        $(which uv 2>/dev/null || echo "Not found")"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
fi
